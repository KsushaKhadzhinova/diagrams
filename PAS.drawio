        <mxCell id="e2OYsyv5p8LDRWVvSj_w-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=40;" value="&lt;span style=&quot;color: rgb(31, 31, 31); font-family: &amp;quot;Google Sans Flex&amp;quot;, &amp;quot;Google Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-variant-ligatures: none; text-align: start; background-color: rgb(233, 238, 246);&quot;&gt;Диаграмма деятельности&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="550" x="290" y="5200" as="geometry" />
        </mxCell>
        <mxCell id="e2OYsyv5p8LDRWVvSj_w-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;@startuml&lt;/div&gt;&lt;div&gt;title Диаграмма деятельности: Процесс оформления заказа (Цветочный магазин)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;|Клиент|&lt;/div&gt;&lt;div&gt;start&lt;/div&gt;&lt;div&gt;:Выбрать товары в каталоге;&lt;/div&gt;&lt;div&gt;:Перейти к оформлению заказа;&lt;/div&gt;&lt;div&gt;:Ввести контактные данные\n(ФИО, адрес, телефон);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;|Система|&lt;/div&gt;&lt;div&gt;:Зарегистрировать попытку заказа;&lt;/div&gt;&lt;div&gt;:Проверить наличие товаров на складе;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;if (Все товары в наличии?) then (Да)&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Сформировать итоговую сумму;&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Клиент|&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Ввести платежные данные;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Провести верификацию оплаты;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; if (Оплата успешна?) then (Да)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Создать &#39;Заявку на покупку&#39;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Изменить статус заказа на &#39;Оплачен&#39;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Уведомить клиента об успешном заказе;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; stop&lt;/div&gt;&lt;div&gt;&amp;nbsp; else (Нет)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Уведомить клиента об ошибке оплаты;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Предложить повторную оплату или отмену;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; |Клиент|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (Повторить оплату?) then (Да)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; goto Клиент_Ввести платежные данные&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else (Нет)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; :Аннулировать заказ;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; stop&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; endif&lt;/div&gt;&lt;div&gt;&amp;nbsp; endif&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;else (Нет)&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Уведомить клиента об отсутствии товара;&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Предложить корректировку заказа или отмену;&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Клиент|&lt;/div&gt;&lt;div&gt;&amp;nbsp; if (Корректировать заказ?) then (Да)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; goto Клиент_Выбрать товары в каталоге&lt;/div&gt;&lt;div&gt;&amp;nbsp; else (Нет)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Отменить заказ;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; stop&lt;/div&gt;&lt;div&gt;&amp;nbsp; endif&lt;/div&gt;&lt;div&gt;endif&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;stop&lt;/div&gt;&lt;div&gt;@enduml&lt;/div&gt;" vertex="1">
          <mxGeometry height="1180" width="410" x="-405" y="5280" as="geometry" />
        </mxCell>
        <mxCell id="e2OYsyv5p8LDRWVvSj_w-18" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="559" width="1024" x="56" y="5286" as="geometry" />
        </mxCell>
        <mxCell id="e2OYsyv5p8LDRWVvSj_w-19" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="559" width="1024" x="56" y="2167" as="geometry" />
        </mxCell>
        <mxCell id="e2OYsyv5p8LDRWVvSj_w-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;@startuml&lt;/div&gt;&lt;div&gt;skinparam style strictuml&lt;/div&gt;&lt;div&gt;skinparam monochrome true&lt;/div&gt;&lt;div&gt;skinparam linetype ortho&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;title Диаграмма последовательности: Оформить заказ (Цветочный магазин)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Определение участников с их стереотипами и внешним видом&lt;/div&gt;&lt;div&gt;actor &quot;Зарегистрированный\nпользователь&quot; as User&lt;/div&gt;&lt;div&gt;boundary &quot;Форма оформления\nзаказа&quot; as OrderForm &amp;lt;&amp;lt;Boundary&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;boundary &quot;Форма оплаты\nзаказа&quot; as PaymentForm &amp;lt;&amp;lt;Boundary&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;participant &quot;Заявка на покупку&quot; as OrderApplication &amp;lt;&amp;lt;Entity&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;actor &quot;Работник&quot; as Employee&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Автоматическая нумерация сообщений&lt;/div&gt;&lt;div&gt;autonumber&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Точка начала&lt;/div&gt;&lt;div&gt;[=]User: start&lt;/div&gt;&lt;div&gt;activate User&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1&lt;/div&gt;&lt;div&gt;User -&amp;gt; OrderForm: 1: Выбрать товары()&lt;/div&gt;&lt;div&gt;activate OrderForm&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.1&lt;/div&gt;&lt;div&gt;User -&amp;gt; OrderForm: 1.1: Указать данные для доставки()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.2: Самовызов&lt;/div&gt;&lt;div&gt;OrderForm -&amp;gt; OrderForm: 1.2: Запросить подтверждение\nоформления заказа()&lt;/div&gt;&lt;div&gt;activate OrderForm #darkgrey&lt;/div&gt;&lt;div&gt;deactivate OrderForm&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.3: Ответ пользователю&lt;/div&gt;&lt;div&gt;OrderForm --&amp;gt; User: 1.3: Подтвердить оформление заказа()&lt;/div&gt;&lt;div&gt;deactivate OrderForm&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.4&lt;/div&gt;&lt;div&gt;User -&amp;gt; PaymentForm: 1.4: Указать карту для оплаты()&lt;/div&gt;&lt;div&gt;activate PaymentForm&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.5: Самовызов&lt;/div&gt;&lt;div&gt;PaymentForm -&amp;gt; PaymentForm: 1.5: Запросить подтверждение\nоплаты заказа()&lt;/div&gt;&lt;div&gt;activate PaymentForm #darkgrey&lt;/div&gt;&lt;div&gt;deactivate PaymentForm&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.6: Ответ пользователю&lt;/div&gt;&lt;div&gt;PaymentForm --&amp;gt; User: 1.6: Подтвердить оплату заказа()&lt;/div&gt;&lt;div&gt;deactivate PaymentForm&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.7: Передача к сущности&lt;/div&gt;&lt;div&gt;User -&amp;gt; OrderApplication: 1.7: заявки на покупку()&lt;/div&gt;&lt;div&gt;activate OrderApplication&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.8: Передача к работнику&lt;/div&gt;&lt;div&gt;OrderApplication -&amp;gt; Employee: 1.8: Запросить принятие заявки на покупку()&lt;/div&gt;&lt;div&gt;activate Employee&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.9: Запрос подтверждения&lt;/div&gt;&lt;div&gt;Employee -&amp;gt; User: 1.9: Запросить подтверждение данных заявки()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Сообщение 1.10: Подтверждение данных&lt;/div&gt;&lt;div&gt;User -&amp;gt; Employee: 1.10: Подтвердить данные заявки()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Конечная точка&lt;/div&gt;&lt;div&gt;deactivate Employee&lt;/div&gt;&lt;div&gt;Employee -&amp;gt;[*]:&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;@enduml&lt;/div&gt;" vertex="1">
          <mxGeometry height="1340" width="620" x="-550" y="2167" as="geometry" />
        </mxCell>
        <mxCell id="e2OYsyv5p8LDRWVvSj_w-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=40;" value="Диаграмма классов" vertex="1">
          <mxGeometry height="30" width="450" x="478" y="6860" as="geometry" />
        </mxCell>
        <mxCell id="e2OYsyv5p8LDRWVvSj_w-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;@startuml&lt;/div&gt;&lt;div&gt;&#39; Настройки для соответствия визуальному стилю изображения&lt;/div&gt;&lt;div&gt;skinparam style strictuml&lt;/div&gt;&lt;div&gt;skinparam monochrome true&lt;/div&gt;&lt;div&gt;skinparam linetype ortho&lt;/div&gt;&lt;div&gt;skinparam classAttributeIconSize 0&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;title Диаграмма классов: Система цветочного магазина&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; --- Определение классов ---&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Пользователь&quot; as User {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + имя: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + контактные_данные: String&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Незарегистрированный\nпользователь&quot; as UnregUser {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + зарегистрироваться()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + просмотреть_каталог()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + искать_цветок()&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Зарегистрированный\nпользователь&quot; as RegUser {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - e-mail: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - пароль: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + просмотреть_каталог()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + искать_цветок()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + добавить_в_корзину()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + удалить_из_корзины()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + оформить_заказ()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + просмотреть_заказы()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + выйти()&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Работник&quot; as Employee {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + роль: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + просмотреть_заказы()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + подтвердить_заказ()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + обновить_статус_заказа()&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Заказ&quot; as Order {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - id: int&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - дата: Date&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + статус: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + адрес_доставки: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + итоговая_сумма: float&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + создать()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + изменить_статус()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + отменить()&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Корзина&quot; as Cart {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + итоговая_сумма: float&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + количество_товаров: int&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + добавить_цветок()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + удалить_цветок()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + очистить()&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Элемент заказа\n(OrderItem)&quot; as OrderItem {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + количество: int&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + цена_за_единицу: float&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Цветок&quot; as Flower {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + id: int&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + название: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + тип: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + цена: float&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + количество_в_наличии: int&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Администратор&quot; as Admin {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - e-mail: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - пароль: String&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + добавить_цветок()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + удалить_цветок()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + обновить_цветок()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + рассчитать_средний_чек()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + построить_график_заказов()&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;class &quot;Каталог&quot; as Catalog {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + получить_список_цветов()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + фильтровать_по_категории()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; + найти_по_названию()&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; --- Отношения и связи ---&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Наследование (Generalization)&lt;/div&gt;&lt;div&gt;RegUser -up-|&amp;gt; User : &quot;&amp;lt;&amp;lt;extends&amp;gt;&amp;gt;&quot;&lt;/div&gt;&lt;div&gt;UnregUser -up-|&amp;gt; User : &quot;&amp;lt;&amp;lt;extends&amp;gt;&amp;gt;&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Ассоциации пользователей&lt;/div&gt;&lt;div&gt;User &quot;1&quot; -- &quot;0..1&quot; Cart : &quot;&amp;lt; association (имеет)&quot;&lt;/div&gt;&lt;div&gt;RegUser &quot;1&quot; -- &quot;0..*&quot; Order : &quot;association (делает) &amp;gt;&quot;&lt;/div&gt;&lt;div&gt;Employee &quot;1&quot; -- &quot;0..*&quot; Order : &quot;association (обрабатывает) &amp;gt;&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Агрегация и композиция элементов (согласно символам на схеме)&lt;/div&gt;&lt;div&gt;Order &quot;1&quot; o-- &quot;1..*&quot; OrderItem : &quot;aggregate (состоит из) &amp;gt;&quot;&lt;/div&gt;&lt;div&gt;Cart &quot;1&quot; *-- &quot;1..*&quot; OrderItem : &quot;composite (состоит из) &amp;gt;&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Связь с товаром&lt;/div&gt;&lt;div&gt;OrderItem &quot;1&quot; -- &quot;1&quot; Flower : &quot;association (ссылается на) &amp;gt;&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Администрирование и каталог&lt;/div&gt;&lt;div&gt;Admin &quot;1&quot; -- &quot;1&quot; Catalog : &quot;association (управляет) &amp;gt;&quot;&lt;/div&gt;&lt;div&gt;Catalog &quot;1&quot; o-- &quot;0..*&quot; Flower : &quot;aggregation (содержит) &amp;gt;&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;@enduml&lt;/div&gt;" vertex="1">
          <mxGeometry height="2270" width="550" x="-430" y="6960" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Настройки для соответствия визуальному стилю изображения\nskinparam style strictuml\nskinparam monochrome true\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\n\ntitle Диаграмма классов: Система цветочного магазина\n\n&#39; --- Определение классов ---\n\nclass \&quot;Пользователь\&quot; as User {\n    + имя: String\n    + контактные_данные: String\n}\n\nclass \&quot;Незарегистрированный\\nпользователь\&quot; as UnregUser {\n    + зарегистрироваться()\n    + просмотреть_каталог()\n    + искать_цветок()\n}\n\nclass \&quot;Зарегистрированный\\nпользователь\&quot; as RegUser {\n    - e-mail: String\n    - пароль: String\n    + просмотреть_каталог()\n    + искать_цветок()\n    + добавить_в_корзину()\n    + удалить_из_корзины()\n    + оформить_заказ()\n    + просмотреть_заказы()\n    + выйти()\n}\n\nclass \&quot;Работник\&quot; as Employee {\n    + роль: String\n    + просмотреть_заказы()\n    + подтвердить_заказ()\n    + обновить_статус_заказа()\n}\n\nclass \&quot;Заказ\&quot; as Order {\n    - id: int\n    - дата: Date\n    + статус: String\n    + адрес_доставки: String\n    + итоговая_сумма: float\n    + создать()\n    + изменить_статус()\n    + отменить()\n}\n\nclass \&quot;Корзина\&quot; as Cart {\n    + итоговая_сумма: float\n    + количество_товаров: int\n    + добавить_цветок()\n    + удалить_цветок()\n    + очистить()\n}\n\nclass \&quot;Элемент заказа\\n(OrderItem)\&quot; as OrderItem {\n    + количество: int\n    + цена_за_единицу: float\n}\n\nclass \&quot;Цветок\&quot; as Flower {\n    + id: int\n    + название: String\n    + тип: String\n    + цена: float\n    + количество_в_наличии: int\n}\n\nclass \&quot;Администратор\&quot; as Admin {\n    - e-mail: String\n    - пароль: String\n    + добавить_цветок()\n    + удалить_цветок()\n    + обновить_цветок()\n    + рассчитать_средний_чек()\n    + построить_график_заказов()\n}\n\nclass \&quot;Каталог\&quot; as Catalog {\n    + получить_список_цветов()\n    + фильтровать_по_категории()\n    + найти_по_названию()\n}\n\n&#39; --- Отношения и связи ---\n\n&#39; Наследование (Generalization)\nRegUser -up-|&gt; User : \&quot;&lt;&lt;extends&gt;&gt;\&quot;\nUnregUser -up-|&gt; User : \&quot;&lt;&lt;extends&gt;&gt;\&quot;\n\n&#39; Ассоциации пользователей\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; Cart : \&quot;&lt; association (имеет)\&quot;\nRegUser \&quot;1\&quot; -- \&quot;0..*\&quot; Order : \&quot;association (делает) &gt;\&quot;\nEmployee \&quot;1\&quot; -- \&quot;0..*\&quot; Order : \&quot;association (обрабатывает) &gt;\&quot;\n\n&#39; Агрегация и композиция элементов (согласно символам на схеме)\nOrder \&quot;1\&quot; o-- \&quot;1..*\&quot; OrderItem : \&quot;aggregate (состоит из) &gt;\&quot;\nCart \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem : \&quot;composite (состоит из) &gt;\&quot;\n\n&#39; Связь с товаром\nOrderItem \&quot;1\&quot; -- \&quot;1\&quot; Flower : \&quot;association (ссылается на) &gt;\&quot;\n\n&#39; Администрирование и каталог\nAdmin \&quot;1\&quot; -- \&quot;1\&quot; Catalog : \&quot;association (управляет) &gt;\&quot;\nCatalog \&quot;1\&quot; o-- \&quot;0..*\&quot; Flower : \&quot;aggregation (содержит) &gt;\&quot;\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="e2OYsyv5p8LDRWVvSj_w-25">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="914" width="983" x="170" y="6960" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
