        <mxCell id="e2OYsyv5p8LDRWVvSj_w-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;span style=&quot;color: rgb(31, 31, 31); font-family: &amp;quot;Google Sans Flex&amp;quot;, &amp;quot;Google Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-variant-ligatures: none; text-align: start; background-color: rgb(233, 238, 246);&quot;&gt;Диаграмма деятельности&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="1680" y="4460" as="geometry" />
        </mxCell>
        <mxCell id="e2OYsyv5p8LDRWVvSj_w-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;@startuml&lt;/div&gt;&lt;div&gt;title Диаграмма деятельности: Процесс оформления заказа (Цветочный магазин)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;|Клиент|&lt;/div&gt;&lt;div&gt;start&lt;/div&gt;&lt;div&gt;:Выбрать товары в каталоге;&lt;/div&gt;&lt;div&gt;:Перейти к оформлению заказа;&lt;/div&gt;&lt;div&gt;:Ввести контактные данные\n(ФИО, адрес, телефон);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;|Система|&lt;/div&gt;&lt;div&gt;:Зарегистрировать попытку заказа;&lt;/div&gt;&lt;div&gt;:Проверить наличие товаров на складе;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;if (Все товары в наличии?) then (Да)&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Сформировать итоговую сумму;&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Клиент|&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Ввести платежные данные;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Провести верификацию оплаты;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; if (Оплата успешна?) then (Да)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Создать &#39;Заявку на покупку&#39;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Изменить статус заказа на &#39;Оплачен&#39;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Уведомить клиента об успешном заказе;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; stop&lt;/div&gt;&lt;div&gt;&amp;nbsp; else (Нет)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Уведомить клиента об ошибке оплаты;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Предложить повторную оплату или отмену;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; |Клиент|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (Повторить оплату?) then (Да)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; goto Клиент_Ввести платежные данные&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else (Нет)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; :Аннулировать заказ;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; stop&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; endif&lt;/div&gt;&lt;div&gt;&amp;nbsp; endif&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;else (Нет)&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Уведомить клиента об отсутствии товара;&lt;/div&gt;&lt;div&gt;&amp;nbsp; :Предложить корректировку заказа или отмену;&lt;/div&gt;&lt;div&gt;&amp;nbsp; |Клиент|&lt;/div&gt;&lt;div&gt;&amp;nbsp; if (Корректировать заказ?) then (Да)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; goto Клиент_Выбрать товары в каталоге&lt;/div&gt;&lt;div&gt;&amp;nbsp; else (Нет)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; |Система|&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; :Отменить заказ;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; stop&lt;/div&gt;&lt;div&gt;&amp;nbsp; endif&lt;/div&gt;&lt;div&gt;endif&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;stop&lt;/div&gt;&lt;div&gt;@enduml&lt;/div&gt;" vertex="1">
          <mxGeometry height="1180" width="410" x="1630" y="4540" as="geometry" />
        </mxCell>
        <mxCell id="e2OYsyv5p8LDRWVvSj_w-18" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="559" width="1024" x="2110" y="4520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
