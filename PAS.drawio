        <mxCell id="KQYUuTYXAGj1Xilf_Dxx-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;@startuml&lt;/div&gt;&lt;div&gt;&#39; Установка горизонтальной ориентации&lt;/div&gt;&lt;div&gt;left to right direction&lt;/div&gt;&lt;div&gt;&#39; Настройка квадратных (ортогональных) стрелок&lt;/div&gt;&lt;div&gt;skinparam linetype ortho&lt;/div&gt;&lt;div&gt;skinparam actorStyle awesome&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Актеры&lt;/div&gt;&lt;div&gt;actor &quot;Незарегистрированный\nпользователь&quot; as UnregUser&lt;/div&gt;&lt;div&gt;actor &quot;Зарегистрированный\nпользователь&quot; as RegUser&lt;/div&gt;&lt;div&gt;actor &quot;Администратор&quot; as Admin&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Наследование актеров с подписью на английском&lt;/div&gt;&lt;div&gt;RegUser -up-|&amp;gt; UnregUser : &amp;lt;&amp;lt;inherit&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;rectangle &quot;Система цветочного магазина&quot; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &#39; Группировка: Поиск и Просмотр [cite: 29, 32]&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Просмотреть каталог цветов&quot; as UC_Browse&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Установить фильтры поиска&quot; as UC_Sort&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Посмотреть детали товара&quot; as UC_Zoom&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Проверить наличие на складе&quot; as UC_CheckStock&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &#39; Группировка: Авторизация [cite: 33]&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Зарегистрироваться&quot; as UC_Reg&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Верифицировать e-mail&quot; as UC_VerifyEmail&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Войти в систему&quot; as UC_Login&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Ввести данные аккаунта&quot; as UC_AuthData&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &#39; Группировка: Корзина и Заказы [cite: 21, 32, 33]&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Добавить цветок в корзину&quot; as UC_AddCart&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Пересчитать сумму&quot; as UC_Recalc&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Удалить из корзины&quot; as UC_RemCart&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Оформить заказ&quot; as UC_PlaceOrder&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Выбрать способ оплаты&quot; as UC_Payment&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Ввести данные доставки&quot; as UC_DeliveryData&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &#39; Группировка: Администрирование [cite: 33]&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Управлять каталогом&quot; as UC_ManageCatalog&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Обновить цены&quot; as UC_UpdatePrices&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Анализировать продажи&quot; as UC_Analytics&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; usecase &quot;Задать период отчета&quot; as UC_Dates&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Связи актеров (теперь идут горизонтально)&lt;/div&gt;&lt;div&gt;UnregUser --&amp;gt; UC_Browse&lt;/div&gt;&lt;div&gt;UnregUser --&amp;gt; UC_Reg&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;RegUser --&amp;gt; UC_Login&lt;/div&gt;&lt;div&gt;RegUser --&amp;gt; UC_AddCart&lt;/div&gt;&lt;div&gt;RegUser --&amp;gt; UC_PlaceOrder&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Admin --&amp;gt; UC_ManageCatalog&lt;/div&gt;&lt;div&gt;Admin --&amp;gt; UC_Analytics&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Отношения INCLUDE (обязательные шаги) [cite: 628]&lt;/div&gt;&lt;div&gt;UC_Browse .&amp;gt; UC_CheckStock : &amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;UC_Reg .&amp;gt; UC_VerifyEmail : &amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;UC_Login .&amp;gt; UC_AuthData : &amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;UC_AddCart .&amp;gt; UC_Recalc : &amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;UC_PlaceOrder .&amp;gt; UC_DeliveryData : &amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;UC_PlaceOrder .&amp;gt; UC_Payment : &amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;UC_Analytics .&amp;gt; UC_Dates : &amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Отношения EXTEND (опциональные шаги) [cite: 633]&lt;/div&gt;&lt;div&gt;UC_Sort .&amp;gt; UC_Browse : &amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;UC_Zoom .&amp;gt; UC_Browse : &amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;UC_RemCart .&amp;gt; UC_AddCart : &amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;UC_UpdatePrices .&amp;gt; UC_ManageCatalog : &amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;@enduml&lt;/div&gt;" vertex="1">
