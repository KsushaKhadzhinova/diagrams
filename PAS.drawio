        <mxCell id="e2OYsyv5p8LDRWVvSj_w-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;@startuml&lt;/div&gt;&lt;div&gt;skinparam style strictuml&lt;/div&gt;&lt;div&gt;skinparam monochrome true&lt;/div&gt;&lt;div&gt;skinparam linetype ortho&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;title Диаграмма состояний: Жизненный цикл Заказа&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Определение состояний&lt;/div&gt;&lt;div&gt;state &quot;Создание&quot; as Created : Пользователь выбирает товары\nи указывает данные доставки&lt;/div&gt;&lt;div&gt;state &quot;Ожидание оплаты&quot; as AwaitingPayment&lt;/div&gt;&lt;div&gt;state &quot;Проверка оплаты&quot; as VerifyingPayment&lt;/div&gt;&lt;div&gt;state &quot;Оплачен&quot; as Paid : Заявка на покупку создана&lt;/div&gt;&lt;div&gt;state &quot;Ожидание подтверждения данных&quot; as AwaitingConfirmation : Работник проверяет детали\nс пользователем&lt;/div&gt;&lt;div&gt;state &quot;Обработка&quot; as Processing : Сборка букета работником&lt;/div&gt;&lt;div&gt;state &quot;Отправлен&quot; as Shipped&lt;/div&gt;&lt;div&gt;state &quot;Доставлен&quot; as Delivered&lt;/div&gt;&lt;div&gt;state &quot;Отменен&quot; as Cancelled&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&#39; Переходы и события&lt;/div&gt;&lt;div&gt;[*] --&amp;gt; Created : Выбрать товары()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Created --&amp;gt; AwaitingPayment : Подтвердить оформление заказа()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;AwaitingPayment --&amp;gt; VerifyingPayment : Указать карту для оплаты()&lt;/div&gt;&lt;div&gt;AwaitingPayment --&amp;gt; Cancelled : Отмена пользователем&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;VerifyingPayment --&amp;gt; Paid : Подтвердить оплату заказа() (Успех)&lt;/div&gt;&lt;div&gt;VerifyingPayment --&amp;gt; AwaitingPayment : Ошибка оплаты&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Paid --&amp;gt; AwaitingConfirmation : Запросить принятие заявки()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;AwaitingConfirmation --&amp;gt; Processing : Подтвердить данные заявки() (Успех)&lt;/div&gt;&lt;div&gt;AwaitingConfirmation --&amp;gt; Cancelled : Отказ пользователя / Ошибка данных&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Processing --&amp;gt; Shipped : Сборка завершена&lt;/div&gt;&lt;div&gt;Processing --&amp;gt; Cancelled : Нехватка товара на складе&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Shipped --&amp;gt; Delivered : Доставка подтверждена&lt;/div&gt;&lt;div&gt;Shipped --&amp;gt; Cancelled : Ошибка доставки&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Delivered --&amp;gt; [*]&lt;/div&gt;&lt;div&gt;Cancelled --&amp;gt; [*]&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;@enduml&lt;/div&gt;" vertex="1">
          <mxGeometry height="1050" width="420" x="-400" y="3900" as="geometry" />
