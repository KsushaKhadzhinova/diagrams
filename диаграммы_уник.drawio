        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph A0[\&quot;Управление спа-салоном\&quot;]\n        A0_1[\&quot;Управление пользователями\&quot;]\n        A0_2[\&quot;Управление процедурами\&quot;]\n        A0_3[\&quot;Управление бронированиями\&quot;]\n    end\n\n    subgraph A1[\&quot;Управление пользователями\&quot;]\n        A1_1[\&quot;Регистрация пользователя\&quot;]\n        A1_2[\&quot;Просмотр пользователей\&quot;]\n        A1_3[\&quot;Удаление пользователя\&quot;]\n    end\n\n    subgraph A2[\&quot;Управление процедурами\&quot;]\n        A2_1[\&quot;Добавление процедуры\&quot;]\n        A2_2[\&quot;Просмотр процедур\&quot;]\n        A2_3[\&quot;Удаление процедуры\&quot;]\n    end\n\n    subgraph A3[\&quot;Управление бронированиями\&quot;]\n        A3_1[\&quot;Бронирование процедуры\&quot;]\n        A3_2[\&quot;Просмотр бронирований\&quot;]\n        A3_3[\&quot;Управление статусом\&quot;]\n    end\n\n    A0 --&gt; A1\n    A0 --&gt; A2\n    A0 --&gt; A3\n\n    A1 --&gt; A1_1\n    A1 --&gt; A1_2\n    A1 --&gt; A1_3\n\n    A2 --&gt; A2_1\n    A2 --&gt; A2_2\n    A2 --&gt; A2_3\n\n    A3 --&gt; A3_1\n    A3 --&gt; A3_2\n    A3 --&gt; A3_3\n\n    %% Входные потоки\n    A1_1 --&gt;|\&quot;Данные пользователя\&quot;| A1\n    A2_1 --&gt;|\&quot;Описание процедуры\&quot;| A2\n    A3_1 --&gt;|\&quot;Данные бронирования\&quot;| A3\n\n    %% Выходные потоки\n    A1 --&gt;|\&quot;Информация о пользователях\&quot;| A0\n    A2 --&gt;|\&quot;Список процедур\&quot;| A0\n    A3 --&gt;|\&quot;Статус бронирований\&quot;| A0\n\n    %% Механизмы\n    A1 -.-&gt;|\&quot;Система авторизации\&quot;| A0\n    A2 -.-&gt;|\&quot;База данных процедур\&quot;| A0\n    A3 -.-&gt;|\&quot;Система бронирования\&quot;| A0\n\n    %% Контекст\n    A0 -.-&gt;|\&quot;Пользователи системы\&quot;| A1\n    A0 -.-&gt;|\&quot;Каталог процедур\&quot;| A2\n    A0 -.-&gt;|\&quot;Бронирования\&quot;| A3\n\n    %% Стили\n    classDef main fill:#f9f,stroke:#333,stroke-width:4px,color:#000\n    classDef sub fill:#bbf,stroke:#333,stroke-width:2px,color:#000\n    classDef process fill:#dfd,stroke:#333,color:#000\n    classDef flow fill:#fff,stroke:#333,color:#000\n    \n    class A0 main\n    class A1,A2,A3 sub\n    class A1_1,A1_2,A1_3,A2_1,A2_2,A2_3,A3_1,A3_2,A3_3 process\n    class A0_1,A0_2,A0_3 flow&quot;&#xa;}" id="qCecJ-tQV7cBjpiRLdbc-41">
