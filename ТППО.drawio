        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Контекстная диаграмма A-0\n    A0[\&quot;0: Система электронного документооборота\&quot;]\n    \n    %% Граничные стрелки A-0\n    I1[(\&quot;Входящие документы\&quot;)] --&gt; A0\n    C1[(\&quot;Законодательство РБ\&quot;)] --&gt; A0\n    M1[(\&quot;Программное обеспечение\&quot;)] --&gt; A0\n    A0 --&gt; O1[(\&quot;Архивированные документы\&quot;)]\n    \n    %% Декомпозиция A0 (4 блока)\n    subgraph Декомпозиция_Уровень_1\n        A1[\&quot;1: Регистрация\&quot;]\n        A2[\&quot;2: Согласование\&quot;]\n        A3[\&quot;3: Утверждение\&quot;]\n        A4[\&quot;4: Хранение\&quot;]\n        \n        %% Расположение по диагонали\n        A1 --&gt; A2 --&gt; A3 --&gt; A4\n    end\n\n    %% Связи между блоками\n    I1 --&gt; A1\n    C1 --&gt; A1 &amp; A2 &amp; A3 &amp; A4\n    A1 --&gt;|Электронная карточка| A2\n    A2 --&gt;|Протокол согласования| A3\n    A3 --&gt;|Утвержденный документ| A4\n    A4 --&gt; O1\n    \n    %% Механизмы\n    M1 --&gt; A1\n    M2[(\&quot;Персонал\&quot;)] --&gt; A2\n    M3[(\&quot;Серверы\&quot;)] --&gt; A4\n    \n    %% Обратная связь и туннелирование\n    A3 --&gt;|Обратная связь| A2\n    T1[(\&quot;Резервные копии\&quot;)] -.-&gt; A0\n    T2[(\&quot;Логи действий\&quot;)] -.-&gt; A0\n\n    %% Стили стрелок\n    linkStyle 0 stroke:#004080,stroke-width:2px;\n    linkStyle 1 stroke:#800000,stroke-width:2px;\n    linkStyle 2 stroke:#008000,stroke-width:2px;\n    linkStyle 3 stroke:#cc6600,stroke-width:2px;\n    linkStyle 4 stroke:#004080,stroke-width:2px;\n    linkStyle 5 stroke:#004080,stroke-width:2px;\n    linkStyle 6 stroke:#cc6600,stroke-width:2px;\n    linkStyle 7 stroke:#008000,stroke-width:2px;\n    linkStyle 8 stroke:#008000,stroke-width:2px;\n    linkStyle 9 stroke:#800080,stroke-width:2px;\n    linkStyle 10,11 stroke:#666666,stroke-dasharray:5;\n\n    %% Стили блоков\n    classDef block fill:#fff,stroke:#333,stroke-width:2px;\n    class A0,A1,A2,A3,A4 block;&quot;&#xa;}" id="tObICif_sjps7nWBbMfF-1">
